{
  "name": "@kontsedal/light-query",
  "version": "0.0.31",
  "description": "A lightweight and dumb react-query alternative",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "lint": "biome lint --fix .",
    "release": "npm run build && np"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "author": "Kontsedal",
  "keywords": [
    "react",
    "query",
    "react-query",
    "data fetching",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kontsedal/light-query.git"
  },
  "bugs": {
    "url": "https://github.com/kontsedal/light-query/issues"
  },
  "homepage": "https://github.com/kontsedal/light-query#readme",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.3",
    "@faker-js/faker": "^10.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "np": "^11.0.2",
    "react": "19",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
